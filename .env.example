# Copy to .env for local development: cp .env.example .env

# Postgres superuser/owner used by the postgres container and migrations.
POSTGRES_USER=familyshop
POSTGRES_PASSWORD=familyshop
POSTGRES_DB=familyshop

# Password for the non-superuser application role (RLS applies to it).
APP_DB_PASSWORD=familyshop_app

# Port Caddy listens on for the browser (http://localhost:8080).
PUBLIC_PORT=8080

# API settings when running outside docker (go run ./cmd/api).
APP_ENV=development
HTTP_ADDR=:8081
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://familyshop_app:familyshop_app@localhost:5432/familyshop?sslmode=disable
MIGRATION_DATABASE_URL=postgres://familyshop:familyshop@localhost:5432/familyshop?sslmode=disable
